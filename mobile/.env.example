# Copy to .env and fill in from Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# These identify the project; they are not secrets. Access is controlled by
# sign-in and the database rules. .env is still kept out of git.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=
