{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$dev": {
        ".read": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).exists()",
        "members": {
          ".write": false
        },
        "status": {
          ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device'"
        },
        "config": {
          ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device'"
        },
        "events": {
          ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device'"
        },
        "history": {
          ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device'"
        },
        "results": {
          "$id": {
            ".write": "(auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device') || (auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'owner' && !newData.exists())"
          }
        },
        "commands": {
          ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device' && !newData.exists()",
          "$id": {
            ".write": "(auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'device' && !newData.exists()) || (auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'owner' && (!newData.exists() || (!data.exists() && newData.child('ts').val() === now && newData.child('uid').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['type', 'ts', 'uid']) && newData.child('type').isString() && newData.child('type').val().length <= 20"
          }
        },
        "logbook": {
          "$id": {
            ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'owner'",
            ".validate": "newData.child('kind').isString() && newData.child('kind').val().length <= 80 && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 1000))"
          }
        },
        "record": {
          ".write": "auth != null && root.child('devices').child($dev).child('members').child(auth.uid).val() === 'owner'",
          "$field": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          }
        }
      }
    }
  }
}
